# Bu dosya sadece panelin ihtiyaç duyduğu ortam değişkenlerinin İSİMLERİNİ ve
# ne için kullanıldıklarını listeler — hiçbir değer içermez. Gerçek değerleri
# .env.local dosyasına yazın (o dosya git'e girmez).
#
# Tümü sunucu-only: hiçbiri NEXT_PUBLIC_ önekiyle tarayıcıya gönderilmez —
# bu proje bilinçli olarak tarayıcıya hiçbir ortam değişkeni sızdırmaz
# (bkz. src/lib/supabase/client.ts).

# --- Supabase (panelin veritabanı) ---
# Sunucu-only. Supabase proje REST URL'si.
SUPABASE_URL=
# Sunucu-only. Supabase anon/public API anahtarı — RLS'e tabi okuma/yazmalar için (createSupabaseServerClient).
SUPABASE_ANON_KEY=
# Sunucu-only. Supabase service_role anahtarı — RLS'i atlar, sadece admin-only yazma yollarında kullanılır (createSupabaseAdminClient).
SUPABASE_SERVICE_ROLE_KEY=

# --- Mail (Resend) ---
# Sunucu-only. Resend API anahtarı.
RESEND_API_KEY=
# Sunucu-only. Giden tüm maillerin "Gönderen" adresi. Üretimde: info@incidmcturizm.com
MAIL_FROM=
# Sunucu-only. "Yeni talep" ve "yeni acente kaydı" bildirimlerinin gideceği admin adresleri — virgülle ayrılmış liste.
ADMIN_NOTIFICATION_EMAILS=
# Sunucu-only. Panelin kendi genel adresi — acente onay mailindeki giriş bağlantısını oluşturmak için (örn. https://panel.incidmcturizm.com).
PANEL_BASE_URL=

# --- Operation Management entegrasyonu (omSync) ---
# Sunucu-only. Operation Management sisteminin API taban adresi.
OPERATION_MANAGEMENT_BASE_URL=
# Sunucu-only. Operation Management API'sine gönderilen Bearer token.
OPERATION_MANAGEMENT_API_SECRET=
# Sunucu-only. /api/cron/om-sync uç noktasını çağıran cron job'ın kullandığı paylaşılan secret.
OM_SYNC_CRON_SECRET=
